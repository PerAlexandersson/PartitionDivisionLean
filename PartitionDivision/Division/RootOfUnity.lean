/-!
# The root-of-unity specialization bridge

This file places the specialized Pieri coefficients in the local ring of the polynomial line at
`v = 1`, evaluates them there as nonnegative rational numbers, and applies the abstract assembly
theorem.  The only remaining assumptions are the conditional Pieri basis identities.
-/

@[expose] public section

noncomputable section

open scoped BigOperators

namespace PartitionDivision

open Matrix MvPolynomial Polynomial
open Nat.PartitionVector Nat.PartitionVector.Pieri

local instance (p : Prop) : Decidable p := Classical.propDecidable p

/-- The prime ideal of polynomials vanishing at one. -/
def evalOneIdeal (L : Type*) [Field L] : Ideal L[X] :=
  RingHom.ker (evalRingHom 1)

/-- The ideal of polynomials vanishing at one is prime. -/
instance evalOneIdeal_isPrime (L : Type*) [Field L] : (evalOneIdeal L).IsPrime :=
  RingHom.ker_isPrime (evalRingHom 1)

/-- The ideal of polynomials vanishing at one is generated by `X - 1`. -/
theorem evalOneIdeal_eq_span (L : Type*) [Field L] :
    evalOneIdeal L = Ideal.span {Polynomial.X - 1} := by
  simpa [evalOneIdeal] using ker_evalRingHom (R := L) 1

/-- The local ring of rational functions regular at `v = 1`. -/
abbrev RegularAtOne (L : Type*) [Field L] := Localization.AtPrime (evalOneIdeal L)

/-- The rational-function field over `L`. -/
abbrev RationalFunction (L : Type*) [Field L] := FractionRing L[X]

/-- The embedding of the local ring at one into the rational-function field. -/
def regularAtOneToFractionRing (L : Type*) [Field L] :
    RegularAtOne L →+* RationalFunction L := by
  let g : L[X] →+* RationalFunction L := algebraMap L[X] (RationalFunction L)
  exact IsLocalization.lift fun y : (evalOneIdeal L).primeCompl ↦
    show IsUnit (g (y : L[X])) from
      isUnit_iff_ne_zero.mpr <| by
        change algebraMap L[X] (RationalFunction L) (y : L[X]) ≠ 0
        rw [← map_zero (algebraMap L[X] (RationalFunction L))]
        apply (IsFractionRing.injective L[X] (RationalFunction L)).ne
        change (y : L[X]) ≠ (0 : L[X])
        intro hy
        apply y.2
        rw [hy]
        exact (evalOneIdeal L).zero_mem

/-- The embedding of the local ring at one into the fraction field is injective. -/
theorem regularAtOneToFractionRing_injective (L : Type*) [Field L] :
    Function.Injective (regularAtOneToFractionRing L) := by
  apply IsLocalization.injective_of_map_algebraMap_zero
    (M := (evalOneIdeal L).primeCompl) (RegularAtOne L)
    (regularAtOneToFractionRing L)
  intro x hx
  rw [regularAtOneToFractionRing, IsLocalization.lift_eq] at hx
  rw [← map_zero (algebraMap L[X] (RationalFunction L))] at hx
  have hzero : x = 0 := IsFractionRing.injective L[X] (RationalFunction L) hx
  rw [hzero, map_zero]

/-- Evaluation at one on the local ring of rational functions regular there. -/
def regularAtOneEval (L : Type*) [Field L] : RegularAtOne L →+* L :=
  IsLocalization.lift (g := evalRingHom 1) fun y : (evalOneIdeal L).primeCompl ↦
    isUnit_iff_ne_zero.mpr <| by
      intro hy
      exact y.2 hy

/-- The image of `z` in the rational-function field. -/
def constantRationalFunction {L : Type*} [Field L] (z : L) : RationalFunction L :=
  algebraMap L[X] (RationalFunction L) (Polynomial.C z)

/-- The specialization `t = z v` in the rational-function field. -/
def scaledVariableRationalFunction {L : Type*} [Field L] (z : L) :
    RationalFunction L :=
  algebraMap L[X] (RationalFunction L) (Polynomial.C z * Polynomial.X)

private theorem eval_zero_binomial_C_C_mul_X {L : Type*} [Field L]
    (z : L) (a b : ℕ) (hb : 0 < b) :
    (binomial (Polynomial.C z) (Polynomial.C z * Polynomial.X) a b : L[X]).eval 0 =
      1 := by
  simp [binomial, hb.ne']

private theorem eval_zero_pairDen_C_C_mul_X {L : Type*} [Field L]
    (z : L) (lam : Nat.PartitionVector N) {delta : Strip N}
    {ij : Fin N × Fin N} (hij : ij ∈ rowPairs delta) :
    (pairDen lam (Polynomial.C z) (Polynomial.C z * Polynomial.X) ij : L[X]).eval 0 =
      1 := by
  rw [pairDen, Polynomial.eval_mul,
    eval_zero_binomial_C_C_mul_X z _ _ (rowDistance_pos hij),
    eval_zero_binomial_C_C_mul_X z _ _ (rowDistance_pos hij), one_mul]

/-- The Pieri denominator at `q = z`, `t = z v` is a nonzero polynomial. -/
theorem pieriDen_C_C_mul_X_ne_zero {L : Type*} [Field L] (z : L)
    (lam : Nat.PartitionVector N) (delta : Strip N) :
    pieriDen lam delta (Polynomial.C z) (Polynomial.C z * Polynomial.X) ≠
      (0 : L[X]) := by
  intro hzero
  have heval : (pieriDen lam delta (Polynomial.C z)
      (Polynomial.C z * Polynomial.X) : L[X]).eval 0 = 1 := by
    rw [pieriDen, Polynomial.eval_prod]
    apply Finset.prod_eq_one
    intro ij hij
    exact eval_zero_pairDen_C_C_mul_X z lam hij
  rw [hzero, Polynomial.eval_zero] at heval
  exact zero_ne_one heval

private structure RegularPieriPresentation {L : Type*} [Field L]
    (z : L) (lam : Nat.PartitionVector N) (delta : Strip N) where
  numerator : L[X]
  denominator : L[X]
  weight : ℚ≥0
  cross : pieriNum lam delta (Polynomial.C z) (Polynomial.C z * Polynomial.X) *
      denominator =
    pieriDen lam delta (Polynomial.C z) (Polynomial.C z * Polynomial.X) * numerator
  denominator_eval_ne : denominator.eval 1 ≠ 0
  value : numerator.eval 1 / denominator.eval 1 = (weight : L)

private theorem regularPieriPresentation_nonempty
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) : Nonempty (RegularPieriPresentation z lam delta) := by
  obtain ⟨p, r, w, hcross, hr, hvalue⟩ :=
    exists_pieri_regularPresentation hz hdelta
  exact ⟨⟨p, r, w, hcross, hr, hvalue⟩⟩

private noncomputable def regularPieriPresentation
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) : RegularPieriPresentation z lam delta :=
  Classical.choice (regularPieriPresentation_nonempty hz hdelta)

private def regularDenominatorUnit
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) : (evalOneIdeal L).primeCompl :=
  ⟨(regularPieriPresentation hz hdelta).denominator, by
    intro hmem
    exact (regularPieriPresentation hz hdelta).denominator_eval_ne hmem⟩

/-- The regular-at-one lift of a specialized Pieri coefficient; illegal strips are assigned
zero. -/
private def regularPieriCoefficient
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) (lam : Nat.PartitionVector N) (delta : Strip N) :
    RegularAtOne L := by
  classical
  exact if hdelta : IsLegal lam delta then
    IsLocalization.mk' (RegularAtOne L) (regularPieriPresentation hz hdelta).numerator
      (regularDenominatorUnit hz hdelta)
  else 0

/-- The nonnegative rational value of a specialized Pieri coefficient; illegal strips are
assigned zero. -/
private def rationalPieriWeight
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) (lam : Nat.PartitionVector N) (delta : Strip N) : ℚ≥0 := by
  classical
  exact if hdelta : IsLegal lam delta then (regularPieriPresentation hz hdelta).weight else 0

private theorem map_regularPieriCoefficient
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) :
    regularAtOneToFractionRing L (regularPieriCoefficient hz lam delta) =
      pieriCoefficient (constantRationalFunction z) (scaledVariableRationalFunction z)
        lam delta := by
  let g : L[X] →+* RationalFunction L := algebraMap L[X] (RationalFunction L)
  let d := regularPieriPresentation hz hdelta
  have hdenPoly : pieriDen lam delta (Polynomial.C z)
      (Polynomial.C z * Polynomial.X) ≠ (0 : L[X]) :=
    pieriDen_C_C_mul_X_ne_zero z lam delta
  have hden : pieriDen lam delta (g (Polynomial.C z))
      (g (Polynomial.C z * Polynomial.X)) ≠ 0 := by
    rw [← map_pieriDen g, ← map_zero g]
    exact (IsFractionRing.injective L[X] (RationalFunction L)).ne hdenPoly
  have hcross := congrArg g d.cross
  rw [map_mul, map_mul, map_pieriNum, map_pieriDen] at hcross
  simp only [regularPieriCoefficient, hdelta, dite_true]
  rw [regularAtOneToFractionRing,
    IsLocalization.lift_mk'_spec]
  change g d.numerator = g d.denominator *
    pieriCoefficient (g (Polynomial.C z)) (g (Polynomial.C z * Polynomial.X)) lam delta
  rw [pieriCoefficient, ← mul_div_assoc, eq_div_iff hden]
  simpa only [mul_comm] using hcross.symm

private theorem eval_regularPieriCoefficient
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) :
    regularAtOneEval L (regularPieriCoefficient hz lam delta) =
      (rationalPieriWeight hz lam delta : L) := by
  let d := regularPieriPresentation hz hdelta
  simp only [regularPieriCoefficient, hdelta, dite_true]
  rw [regularAtOneEval,
    IsLocalization.lift_mk'_spec]
  change d.numerator.eval 1 = d.denominator.eval 1 *
    (rationalPieriWeight hz lam delta : L)
  simp only [rationalPieriWeight, hdelta, dite_true]
  change d.numerator.eval 1 = d.denominator.eval 1 * (d.weight : L)
  have hvalue := (div_eq_iff d.denominator_eval_ne).mp d.value
  simpa only [mul_comm] using hvalue

/-- Every legal Pieri coefficient at `q = z`, `t = z v` is the image of an element regular at
`v = 1`, and that element evaluates to a nonnegative rational number. -/
theorem exists_regularAtOne_pieriCoefficient
    {L : Type*} [Field L] [CharZero L] {z : L} {k : ℕ}
    (hz : IsPrimitiveRoot z k) {lam : Nat.PartitionVector N} {delta : Strip N}
    (hdelta : IsLegal lam delta) :
    ∃ a : RegularAtOne L, ∃ w : ℚ≥0,
      regularAtOneToFractionRing L a =
          pieriCoefficient (constantRationalFunction z) (scaledVariableRationalFunction z)
            lam delta ∧
        regularAtOneEval L a = (w : L) := by
  exact ⟨regularPieriCoefficient hz lam delta, rationalPieriWeight hz lam delta,
    map_regularPieriCoefficient hz hdelta, eval_regularPieriCoefficient hz hdelta⟩

private def rootDifferenceMonomial {R : Type*} [CommRing R]
    (c : R) (xi : Nat.PartitionVector N) : MvPolynomial (Fin N) R :=
  MvPolynomial.C c * monomial (differenceFinsupp xi) 1

private def regularPieriTransitionPolynomial
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ)
    (tau lam : KRestricted N k) : MvPolynomial (Fin N) (RegularAtOne L) := by
  classical
  exact ∑ delta : Strip N,
    if IsLegal lam.1 delta ∧ stripWeight delta = r ∧
        (decompositionEquiv N k hk (addStrip lam.1 delta)).1 = tau then
      rootDifferenceMonomial (regularPieriCoefficient hz lam.1 delta)
        (decompositionEquiv N k hk (addStrip lam.1 delta)).2
    else 0

private def regularPieriTransitionMatrix
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ) :
    Matrix (KRestricted N k) (KRestricted N k)
      (MvPolynomial (Fin N) (RegularAtOne L)) :=
  fun tau lam ↦ regularPieriTransitionPolynomial hz hk r tau lam

private def rationalPieriTransitionPolynomial
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ)
    (tau lam : KRestricted N k) : MvPolynomial (Fin N) ℚ := by
  classical
  exact ∑ delta : Strip N,
    if IsLegal lam.1 delta ∧ stripWeight delta = r ∧
        (decompositionEquiv N k hk (addStrip lam.1 delta)).1 = tau then
      rootDifferenceMonomial (rationalPieriWeight hz lam.1 delta : ℚ)
        (decompositionEquiv N k hk (addStrip lam.1 delta)).2
    else 0

private def rationalPieriTransitionMatrix
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ) :
    Matrix (KRestricted N k) (KRestricted N k) (MvPolynomial (Fin N) ℚ) :=
  fun tau lam ↦ rationalPieriTransitionPolynomial hz hk r tau lam

private theorem map_differenceMonomial
    {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S)
    (c : R) (xi : Nat.PartitionVector N) :
    MvPolynomial.map g (rootDifferenceMonomial c xi) =
      rootDifferenceMonomial (g c) xi := by
  simp [rootDifferenceMonomial]

private theorem map_regularPieriTransitionMatrix
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ) :
    pieriTransitionMatrix (N := N) hk (constantRationalFunction z)
        (scaledVariableRationalFunction z) r =
      (regularPieriTransitionMatrix (N := N) hz hk r).map
        (MvPolynomial.map (regularAtOneToFractionRing L)) := by
  classical
  apply Matrix.ext
  intro tau lam
  change pieriTransitionPolynomial hk (constantRationalFunction z)
      (scaledVariableRationalFunction z) r tau lam =
    MvPolynomial.map (regularAtOneToFractionRing L)
      (regularPieriTransitionPolynomial hz hk r tau lam)
  rw [pieriTransitionPolynomial, regularPieriTransitionPolynomial, map_sum]
  apply Finset.sum_congr rfl
  intro delta _
  by_cases hselect : IsLegal lam.1 delta ∧ stripWeight delta = r ∧
      (decompositionEquiv N k hk (addStrip lam.1 delta)).1 = tau
  · simp only [ite_eq_left hselect]
    rw [map_differenceMonomial,
      map_regularPieriCoefficient hz hselect.1]
    rfl
  · simp [hselect]

private theorem eval_regularPieriTransitionMatrix
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ) :
    (regularPieriTransitionMatrix (N := N) hz hk r).map
        (MvPolynomial.map (regularAtOneEval L)) =
      (rationalPieriTransitionMatrix (N := N) hz hk r).map
        (MvPolynomial.map (Rat.castHom L)) := by
  classical
  apply Matrix.ext
  intro tau lam
  change MvPolynomial.map (regularAtOneEval L)
      (regularPieriTransitionPolynomial hz hk r tau lam) =
    MvPolynomial.map (Rat.castHom L)
      (rationalPieriTransitionPolynomial hz hk r tau lam)
  rw [regularPieriTransitionPolynomial, rationalPieriTransitionPolynomial, map_sum, map_sum]
  apply Finset.sum_congr rfl
  intro delta _
  by_cases hselect : IsLegal lam.1 delta ∧ stripWeight delta = r ∧
      (decompositionEquiv N k hk (addStrip lam.1 delta)).1 = tau
  · simp only [ite_eq_left hselect]
    rw [map_differenceMonomial, map_differenceMonomial,
      eval_regularPieriCoefficient hz hselect.1]
    congr 2
    simp
  · simp [hselect]

private theorem rational_differenceMonomial_hasNonnegCoeffs
    (w : ℚ≥0) (xi : Nat.PartitionVector N) :
    (rootDifferenceMonomial (w : ℚ) xi).HasNonnegCoeffs := by
  have h := MvPolynomial.HasNonnegCoeffs.map_nnrat
    (monomial (differenceFinsupp xi) w : MvPolynomial (Fin N) ℚ≥0)
  simpa [rootDifferenceMonomial, MvPolynomial.C_mul_monomial] using h

private theorem rationalPieriTransitionMatrix_hasNonnegCoeffs
    {L : Type*} [Field L] [CharZero L] {z : L} {k N : ℕ}
    (hz : IsPrimitiveRoot z k) (hk : 0 < k) (r : ℕ)
    (tau lam : KRestricted N k) :
    (rationalPieriTransitionMatrix (N := N) hz hk r tau lam).HasNonnegCoeffs := by
  classical
  rw [rationalPieriTransitionMatrix, rationalPieriTransitionPolynomial]
  apply MvPolynomial.HasNonnegCoeffs.finset_sum
  intro delta _
  by_cases hselect : IsLegal lam.1 delta ∧ stripWeight delta = r ∧
      (decompositionEquiv N k hk (addStrip lam.1 delta)).1 = tau
  · simp only [hselect]
    exact rational_differenceMonomial_hasNonnegCoeffs _ _
  · simpa [hselect] using
      (MvPolynomial.HasNonnegCoeffs.zero :
        (0 : MvPolynomial (Fin N) ℚ).HasNonnegCoeffs)

/-- A symmetric basis satisfying the Pieri and rectangle identities at a primitive root of unity
has the natural-number elementary expansion predicted by partition division. -/
theorem exists_nat_esymm_expansion_of_pieri_at_root_of_unity
    {N k n : ℕ} (hk : 0 < k) (hn : n ≤ N) (mu : (k * n).Partition)
    {L : Type*} [Field L] [CharZero L] {z : L} (hz : IsPrimitiveRoot z k)
    (P : Module.Basis (Nat.PartitionVector N) (RationalFunction L)
      (symmetricSubalgebra (Fin N) (RationalFunction L)))
    (hPieri : SatisfiesPieri P (constantRationalFunction z)
      (scaledVariableRationalFunction z))
    (hzero : P 0 = 1) (hrectangles : SatisfiesRectangles P k) :
    ∃ c : n.Partition → ℕ,
      exponentDiv k (esymmPart (Fin N) ℤ mu) =
        ∑ nu, c nu • esymmPart (Fin N) ℤ nu := by
  let qToRegular : ℚ →+* RegularAtOne L :=
    (algebraMap L[X] (RegularAtOne L)).comp
      ((Polynomial.C : L →+* L[X]).comp (Rat.castHom L))
  let _ : Algebra ℚ (RegularAtOne L) := qToRegular.toAlgebra
  let _ : Algebra (RegularAtOne L) (RationalFunction L) :=
    (regularAtOneToFractionRing L).toAlgebra
  let _ : Algebra ℚ L := (Rat.castHom L).toAlgebra
  let baseToFraction : L →+* RationalFunction L :=
    (algebraMap L[X] (RationalFunction L)).comp Polynomial.C
  have hbase : Function.Injective baseToFraction :=
    (IsFractionRing.injective L[X] (RationalFunction L)).comp Polynomial.C_injective
  let _ : CharZero (RationalFunction L) := charZero_of_injective_ringHom hbase
  have hzFraction : IsPrimitiveRoot (constantRationalFunction z) k := by
    exact hz.map_of_injective hbase
  let ev : RegularAtOne L →ₐ[ℚ] L :=
    { __ := regularAtOneEval L
      commutes' := fun q ↦ by
        change regularAtOneEval L (algebraMap L[X] (RegularAtOne L)
          (Polynomial.C ((Rat.castHom L) q))) = (Rat.castHom L) q
        rw [regularAtOneEval, IsLocalization.lift_eq]
        simp }
  refine exists_nat_esymm_expansion_of_transition_matrices
    (A := RegularAtOne L) (F := RationalFunction L) (G := L)
    (ι := KRestricted N k) hk hn mu hzFraction (card_kRestricted N k)
    (zeroKRestricted hk) (restrictedBasisPolynomial P)
    (restrictedBasisPolynomial_zero P hzero hk)
    (pieriTransitionMatrix hk (constantRationalFunction z)
      (scaledVariableRationalFunction z)) ?_ ?_
    (regularPieriTransitionMatrix (N := N) hz hk) ?_ ev
    (rationalPieriTransitionMatrix (N := N) hz hk) ?_ ?_
  · intro r tau
    exact pieriTransitionMatrix_mul P (constantRationalFunction z)
      (scaledVariableRationalFunction z) hk hzFraction.pow_eq_one hPieri hzero
        hrectangles r tau
  · change Function.Injective (regularAtOneToFractionRing L)
    exact regularAtOneToFractionRing_injective L
  · intro r
    exact map_regularPieriTransitionMatrix hz hk r
  · intro r
    change (regularPieriTransitionMatrix (N := N) hz hk r).map
        (MvPolynomial.map (regularAtOneEval L)) =
      (rationalPieriTransitionMatrix (N := N) hz hk r).map
        (MvPolynomial.map (Rat.castHom L))
    exact eval_regularPieriTransitionMatrix hz hk r
  · intro r tau lam
    exact rationalPieriTransitionMatrix_hasNonnegCoeffs hz hk r tau lam

end PartitionDivision
